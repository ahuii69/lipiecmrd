# cp .env.example .env.local  |  sekrety tylko lokalnie, nie w git
# start.sh → nadpisuje cockpit/.env z morda/.env  |  nadpisania: .env.local
# Aliasy klucza hubu: ../config/hub_key_env_names.json

AIHUB_BASE_URL=http://127.0.0.1:8080
# Must be >= backend AIHUB_REQUEST_TIMEOUT_S (default 120s). Chat turn / image gen use this.
AIHUB_TIMEOUT_MS=120000
# Optional override for /chat/turn only (defaults to max(AIHUB_TIMEOUT_MS, 120000)).
# AIHUB_CHAT_TURN_TIMEOUT_MS=120000

# Bootstrap pierwszego admina: gdy backend ma puste auth_accounts,
# BFF wystawia publicznie GET /auth/registration-status i POST /auth/register.
# UI: /register + link na /login. Po pierwszym koncie rejestracja jest zamknięta.
# Brak ENV auto-seed konta.

# AIHUB_API_KEY=
# HUB_API_KEY=
# API_KEY=
# AIHUB_PROXY_TOKEN=

# Opcjonalnie (dev): musi być =1 także w morda/.env przy starcie Next — wtedy BFF używa
# klucza z ../config/codebase_dev_hub.json gdy brak API_KEY w env.
# AIHUB_USE_CODEBASE_DEV_KEY=1

# PORT=3000
