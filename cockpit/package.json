        "autoprefixer": "^10.4.20",
        "eslint": "^8.57.0",
        "eslint-config-next": "15.5.14",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.15",
        "typescript": "^5.7.2",
        "vitest": "^3.0.5",
