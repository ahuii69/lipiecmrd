        "@radix-ui/react-select": "^2.1.2",
        "@radix-ui/react-separator": "^1.1.0",
        "@radix-ui/react-slot": "^1.1.0",
        "@radix-ui/react-tabs": "^1.1.1",
        "@tanstack/react-query": "^5.56.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^16.6.1",
        "lucide-react": "^0.468.0",
        "next": "15.5.14",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
