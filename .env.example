# ── AI-Hub — .env.example (backend aihub + wspólne klucze z Cockpit) ───────────
# cp .env.example .env  |  start.sh może wygenerować API_KEY / tokeny
# NIGDY nie commituj .env z prawdziwymi sekretami.
#
# Cockpit (Next.js): cockpit/.env.example — start.sh bez --no-frontend buduje/uruchamia frontend.
#
# ARCHITEKTURA (operator):
# • Kanon HTTP: aihub.main + aihub/*_api.py
# • aihub/api/* — LEGACY / UNMOUNTED (nie montowane w main); _LEGACY.md
# • Pamięć: Memory V2 (/memory/v2/*, memory_nodes). Legacy v1 HTTP: flagi AIHUB_DISABLE_LEGACY_* poniżej.
# • Tło: agent worker + opcjonalnie konsolidacja compat_router (AIHUB_CONSOLIDATION_WORKER).

# ── Core runtime (kanon: aihub.config) ──
APP_NAME=AIHub
ENV=production
HOST=127.0.0.1
PORT=8080
WORKERS=1
BASE_DIR=.
DATA_DIR=data
DB_PATH=data/aihub.sqlite3
# sqlite | postgres
DB_BACKEND=sqlite
# Gdy DB_BACKEND=postgres — wymagane (np. docker postgres:16 na 127.0.0.1:5432)
# POSTGRES_DSN=postgresql://USER:HASŁO@127.0.0.1:5432/aihub
#
# Import SQLite → PG przy starcie (tylko postgres): off | sidecar | full | auto
# auto: pierwszy raz pełny import + checkpoint w PG; później lekki. Ponowienie pełnego: AIHUB_SQLITE_REIMPORT=1
AIHUB_SQLITE_IMPORT=auto
AIHUB_SQLITE_IMPORT_BATCH=500
AIHUB_SQLITE_REIMPORT=0
# Konsolidacja wpisów compat_router.mem (workers/consolidation + core/background)
AIHUB_CONSOLIDATION_WORKER=1
LOG_DIR=logs
LOG_LEVEL=INFO
FS_ROOT=data/fs
SNAPSHOT_DIR=data/snapshots
# start.sh: ile sekund czekać na /system/ping (init + import SQLite→PG przy PG). Domyślnie 1800.
# START_BACKEND_WAIT_SEC=1800
# Opcjonalny katalog projektu (domyślnie cwd); ścieżki względne DATA_DIR/DB_PATH są względem BASE_DIR
# BASE_DIR=

# ── Security keys (wygenerowane automatycznie przez start.sh) ──
# HTTP hub auth: nazwy aliasów — plik config/hub_key_env_names.json (Python + Next).
# Dowolna NIEpusta wartość z tych zmiennych = akceptowany x-api-key / Bearer / api_key.
API_KEY=
# AIHUB_API_KEY=
# HUB_API_KEY=
# Osobny sekret zaufania BFF (nagłówek X-AIHub-Proxy-Token); gdy pusty — jak
# pierwszy niepusty z łańcucha AIHUB_API_KEY → HUB_API_KEY → API_KEY → (ten wpis)
# AIHUB_PROXY_TOKEN=
# Legacy/secondary moduły (aihub.core.config); kanoniczny HTTP używa API_KEY z tej samej zmiennej
AIHUB_TOKEN_SECRET=

# ── Dev: jawny klucz hub w repo (config/codebase_dev_hub.json) — WYŁĄCZONE domyślnie ──
# =1 → backend uznaje za poprawny ten sam string co w JSON (bez własnego API_KEY).
# Produkcja: zostaw wyłączone; używaj API_KEY=… powyżej (wygeneruje start.sh).
# AIHUB_USE_CODEBASE_DEV_KEY=1

# ── Local account sessions (auth_accounts / auth_sessions) ──
# Brak ENV auto-seed konta. Gdy tabela auth_accounts jest pusta:
#   1) GET  /auth/registration-status → { "open": true }
#   2) POST /auth/register  { "username", "password" }  → tworzy pierwszego admina + sesję
# Po utworzeniu pierwszego konta rejestracja zostaje zamknięta (403).
# UI: /register (tylko gdy open) oraz link na /login.
# AIHUB_AUTH_REQUIRED=1          # wymuś auth; puste = auto (production lub gdy są konta)
# AIHUB_SESSION_TTL_SECONDS=43200
# AIHUB_SESSION_COOKIE_SECURE=1  # puste = auto (production → Secure)
# AIHUB_BFF_PRINCIPAL_SECRET=    # HMAC signed principal BFF→backend (wymagany)

# ── Public deployment ──
DOMAIN=ahui69.org
PUBLIC_URL=https://ahui69.org

# ── Legacy HTTP w main (STM / memory v1) — kanon: /chat/turn + Memory V2. =1 → 410 na legacy ──
AIHUB_DISABLE_LEGACY_STM_TURN=1
AIHUB_DISABLE_LEGACY_MEMORY_V1_HTTP=1

# ── OpenAPI: GET /gpt-openapi.json (domyślnie <repo>/openapi-gpt.json) ──
# AIHUB_GPT_OPENAPI_PATH=

# ── Opcjonalne nadpisania dla aihub.core.config (adapter → ten sam .env co wyżej) ──
# AIHUB_HOST=
# AIHUB_PORT=
# AIHUB_DATA_DIR=
# AIHUB_DB_PATH=
# AIHUB_FS_ROOT=

# ── Safety toggles ──
AIHUB_REWRITER_READONLY=1
SELF_HEAL_WRITE=0
SELF_HEAL_SNAPSHOT=0
# SQLite dla GET /system/self-heal-db/status (względem BASE_DIR gdy ścieżka względna)
AIHUB_SELF_HEAL_DB=data/self_heal.db
# Debug/internal endpoint gate (disabled by default)
AIHUB_ENABLE_COGNITIVE_DEBUG_ENDPOINT=0

# ── Agent worker ──
AGENT_AUTOSTART=1
AGENT_INTERVAL_S=3.5
AGENT_USER_ID=system:maintenance
# Optional comma-separated real user IDs for background maintenance (empty = system only)
# AIHUB_BACKGROUND_AGENT_USER_IDS=
# Memory V2 consolidation targets (empty = retention-only, no per-user default sweep)
# AIHUB_CONSOLIDATION_USERS=

AGENT_MAX_RETRIES=3
AGENT_RETRY_DELAY_S=1.0

# ── SSE ──
SSE_KEEPALIVE_S=15
SSE_MAX_EVENT_LOG=50000

# ── Search API ──
BRAVE_API_KEY=

# ── Web fetch ──
HTTP_TIMEOUT_S=12
HTTP_MAX_BYTES=2097152

# ── LLM provider / chat runtime ──
LLM_PRIMARY_PROVIDER=deepinfra
LLM_RESERVE_PROVIDER=groq
LLM_RESERVE_PROVIDER_2=ollama
LLM_PROVIDER_NAME=deepinfra
LLM_MODEL_NAME=openai/gpt-oss-120b
LLM_API_KEY=
# optional alias supported by runtime:
DEEPINFRA_API_KEY=
LLM_BASE_URL=https://api.deepinfra.com/v1/openai
# Groq reserve (OpenAI-compatible) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Ollama Cloud reserve #2 (OpenAI-compatible) — https://ollama.com
OLLAMA_API_KEY=
OLLAMA_LLM_BASE_URL=https://ollama.com/v1
OLLAMA_LLM_MODEL=gemma4:31b
LLM_TIMEOUT_S=45
LLM_MAX_RETRIES=2
LLM_PROVIDER_INTERNAL_RETRIES=0
LLM_DEFAULT_TEMPERATURE=0.35
LLM_TOOL_CALLING_ENABLED=1
LLM_STREAMING_ENABLED=0

# Chat mode and tool policy
CHAT_DEFAULT_MODE=chat
CHAT_MAX_TOOL_ITERATIONS=4
CHAT_DEBUG_TOOLS_ENABLED=0

# Historia w prompcie (chat_context_compose — rollup + surowy „ogon” tur)
CHAT_HISTORY_RAW_TAIL=28
CHAT_HISTORY_ROLLUP_MAX_CHARS=12000
CHAT_HISTORY_ROLLUP_SNIP=4000
CHAT_HISTORY_SMART_TRIM_TRIGGER=140

# STT — POST /chat/stt (wymaga CHAT_STT_ENABLED=1 i zależności / endpointu)
CHAT_STT_ENABLED=0
CHAT_STT_BACKEND=self_hosted_whisper
CHAT_STT_MODEL=base
CHAT_STT_DEVICE=cpu
CHAT_STT_COMPUTE_TYPE=int8
CHAT_STT_API_URL=http://127.0.0.1:8081/v1
# CHAT_STT_API_KEY=
CHAT_STT_OPENAI_MODEL=whisper-1
CHAT_STT_TIMEOUT_S=120

# Vision — załączniki obrazów. Dwa warianty backendu:
#  1) Lokalny Ollama:   CHAT_VISION_BACKEND=ollama, model np. llava:7b (wymaga uruchomionego Ollama)
#  2) OpenAI-compatible: CHAT_VISION_BACKEND=openai_compatible + endpoint z modelem vision.
#     Gdy CHAT_VISION_API_URL/CHAT_VISION_API_KEY są puste, runtime używa LLM_BASE_URL/LLM_API_KEY.
#     DeepInfra ma modele vision, np. Qwen/Qwen3-VL-30B-A3B-Instruct lub
#     meta-llama/Llama-3.2-11B-Vision-Instruct (działa na tym samym kluczu co LLM).
CHAT_VISION_ENABLED=0
CHAT_VISION_BACKEND=ollama
CHAT_VISION_OLLAMA_URL=http://127.0.0.1:11434
# CHAT_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# CHAT_VISION_FALLBACK_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
# CHAT_VISION_API_URL=https://api.deepinfra.com/v1/openai
# CHAT_VISION_API_KEY=
CHAT_VISION_TIMEOUT_S=120

# Health: gdy =1, /ops/health i capabilities realnie sondują providerów (np. token Brave,
# endpoint STT). Dzięki temu nieważny klucz nie jest raportowany jako działający backend.
AIHUB_HEALTH_LIVE_PROVIDER_PROBE=0

# Indeks FAISS (względem cwd procesu, chyba że absolutny)
VECTOR_INDEX_PATH=./data/vector.index
VECTOR_META_PATH=./data/vector_meta.json

# ── Cockpit (Next.js) — osobna aplikacja w cockpit/; ./start.sh bez --no-frontend uruchamia też front ──
# Szczegóły: cockpit/.env.example. Te same zmienne mogą być w root .env (next.config ładuje root przy pustym cockpit/.env).
AIHUB_BASE_URL=http://127.0.0.1:8080
AIHUB_TIMEOUT_MS=120000
AIHUB_ENABLE_OPTIONAL_RESEARCH_BACKENDS=1
# Klucze hubu: sekcja Security keys (aliasy + AIHUB_PROXY_TOKEN).

# ── Embeddings (aihub/config.py → embedding_engine) ──
# CANONICAL — minimum pod Voyage (nazwa modelu + klucz):
EMBEDDING_MODEL=voyage-3-large
VOYAGE_API_KEY=

# LEGACY — NIE używać w nowym kodzie (fastembed / memory.embedder):
# AIHUB_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Opcjonalne (pełna konfiguracja silnika — domyślne w aihub.config):
EMBEDDING_PROVIDER=voyage
EMBEDDING_OUTPUT_DIM=1024
EMBEDDING_OUTPUT_DTYPE=float
EMBEDDING_TIMEOUT_SECONDS=30.0
EMBEDDING_MAX_RETRIES=2
# 0 = szybki healthcheck bez live embed_query (testy / CI)
EMBEDDING_HEALTHCHECK_LIVE_PROBE=1

# Allows offline/dev vector fallback if Voyage/ST are unavailable. Real Voyage is still attempted first when configured.
AIHUB_DETERMINISTIC_EMBEDDING_FALLBACK=0
AIHUB_ALLOW_EMBEDDING_PROVIDER_FALLBACK=0

AIHUB_RETENTION_ENABLED=1

AIHUB_RETENTION_EVENT_LOG_DAYS=30

AIHUB_RETENTION_PSYCHE_EVENTS_DAYS=30

# Required when ENV=production (Fernet urlsafe key)
AIHUB_USER_VAULT_KEY=
